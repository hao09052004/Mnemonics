# Production Environment Variables — Koyeb
#
# This file is the deployment checklist for the Koyeb free-tier
# service `mnemonics-api`. Set every value listed here in the
# Koyeb dashboard for the service.
# DO NOT commit actual secrets to git.
#
# Koyeb path: https://app.koyeb.com → mnemonics-api → Settings →
# Environment Variables. Values marked REQUIRED must be set; values
# marked OPTIONAL have a working default in code.
#
# After editing, click "Save and Deploy"; the service redeploys
# automatically (~30-60 s).

# ──────────────────────────────────────────────────────────────────
# SERVER
# ──────────────────────────────────────────────────────────────────
NODE_ENV=production                # REQUIRED. Disables dev-only code paths.
PORT=4000                          # Koyeb auto-assigns, this is fallback.

# ──────────────────────────────────────────────────────────────────
# DATABASE (Supabase free tier)
# ──────────────────────────────────────────────────────────────────
# Use the Supabase **Session pooler** (port 5432) for migrations and
# the **Transaction pooler** (port 6543) for the API runtime so
# PgBouncer-compatible prepared statements work.
# Get the URL from: https://supabase.com/dashboard/project/<id>/settings/database
DATABASE_URL=postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ──────────────────────────────────────────────────────────────────
# SUPABASE AUTH
# ──────────────────────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard/project/<id>/settings/api
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=eyJhbGc...        # Public client key (safe in browser).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc... # Server-only. Never exposed to client.

# ──────────────────────────────────────────────────────────────────
# GEMINI (Google AI Studio Free Tier)
# ──────────────────────────────────────────────────────────────────
# CRITICAL: This MUST be an AI Studio key (`AIza...`), NOT an ADC
# token (`AQ.Ab8RN...`). ADC tokens only work inside your dev
# machine with `gcloud auth`. Get the key from:
#   https://aistudio.google.com/apikey
# Free tier limits (gemini-embedding-001 / text-2.x):
#   15 RPM, 1M TPM, 1500 RPD per model.
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=1024

# ──────────────────────────────────────────────────────────────────
# OCR
# ──────────────────────────────────────────────────────────────────
# Production target: server-side Gemini multimodal text extraction.
# The local Tesseract fallback is disabled to avoid pulling a 30 MB
# WASM binary on first use.
OCR_PROVIDER=gemini
OCR_LOCAL_FALLBACK=false

# ──────────────────────────────────────────────────────────────────
# UNDERSTANDING (image caption + TLDR)
# ──────────────────────────────────────────────────────────────────
AI_IMAGE_DESCRIPTION_PROVIDER=gemini
AI_IMAGE_DESCRIPTION_ALLOW_DOWNLOAD=false
AI_TLDR_PROVIDER=gemini

# ──────────────────────────────────────────────────────────────────
# VISUAL EMBEDDINGS
# ──────────────────────────────────────────────────────────────────
# Set to `gemini` if `gemini-embedding-2` is verified on Free Tier
# (see docs/deployment.md#gemini-billing). Set to `local` to use the
# CLIP model on first use (downloads ~150 MB).
VISUAL_EMBEDDING_PROVIDER=local
GEMINI_VISUAL_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_VISUAL_EMBEDDING_DIMENSIONS=512

# ──────────────────────────────────────────────────────────────────
# FALLBACK POLICY
# ──────────────────────────────────────────────────────────────────
# When the primary Gemini call fails, fall back to the local
# deterministic heuristic (text) or noop (embedding → lexical-only
# search). Keep these TRUE in production so a Gemini outage does
# not 500 the search route.
AI_TEXT_FALLBACK=true
AI_EMBEDDING_FALLBACK=true

# ──────────────────────────────────────────────────────────────────
# GEMINI RESILIENCE (PACE / TIMEOUT)
# ──────────────────────────────────────────────────────────────────
# The shared pacer covers text + embedding + OCR + image + TLDR.
# 12 RPM keeps ~3 RPM headroom under the 15 RPM per-model cap.
GEMINI_REQUEST_TIMEOUT_MS=15000
GEMINI_MAX_RETRIES=2
GEMINI_MAX_CONCURRENT_REQUESTS=4
GEMINI_RATE_LIMIT_RPM=12
GEMINI_QUEUE_WAIT_TIMEOUT_MS=60025
GEMINI_TOTAL_BUDGET_MS=60000
GEMINI_TLDR_TOTAL_BUDGET_MS=90000

# ──────────────────────────────────────────────────────────────────
# QUOTAS
# ──────────────────────────────────────────────────────────────────
# Per-user daily AI call cap. Prevents a single user from burning
# the shared Free-Tier quota.
AI_USER_DAILY_LIMIT=100

# ──────────────────────────────────────────────────────────────────
# AUTH (production hardening)
# ──────────────────────────────────────────────────────────────────
# Set to `false` so the email verification gate is enforced for new
# accounts. For the first 24 h after launch, set to `true` to skip
# email confirmation and onboard faster; flip to `false` after.
AUTH_AUTO_CONFIRM=false

# Dev shortcuts — MUST be unset (empty) in production.
# The API refuses to start if these are set in NODE_ENV=production
# (see apps/api/src/server.ts). Setting them anyway breaks the
# production-auth contract.
DEV_AUTH_TOKEN=
DEV_USER_ID=

# ──────────────────────────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API. Use the
# Vercel URL from Step 6 of the deployment guide. NO trailing slash.
# Example: https://mnemonics-web.vercel.app
CORS_ALLOWED_ORIGINS=https://<your-app>.vercel.app

# ──────────────────────────────────────────────────────────────────
# BILLING (M3 — PayOS)
# ──────────────────────────────────────────────────────────────────
# Leave BILLING_ENABLED=false until you have PayOS merchant
# credentials. The payos routes 404 when disabled.
BILLING_ENABLED=false
PAYMENT_PROVIDER=payos
PAYMENT_CURRENCY=VND
PAYMENT_ORDER_EXPIRY_MINUTES=30
PAYMENT_RETURN_URL=https://<your-app>.vercel.app/billing/return
PAYMENT_CANCEL_URL=https://<your-app>.vercel.app/billing/cancel
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# ──────────────────────────────────────────────────────────────────
# DEMO MODE
# ──────────────────────────────────────────────────────────────────
# MUST be `false` in production. Demo mode bypasses auth and uses
# a hard-coded user id.
DEMO_MODE=false
