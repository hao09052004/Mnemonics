{
  "name": "@mnemonics/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "pnpm --filter @mnemonics/shared build && pnpm --filter @mnemonics/database build && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=json --coverage.reportsDirectory=coverage",
    "demo:setup": "pnpm --filter @mnemonics/shared build && pnpm --filter @mnemonics/database build && tsx scripts/demo-setup.mts",
    "demo": "pnpm --filter @mnemonics/shared build && pnpm --filter @mnemonics/database build && tsx scripts/demo-server.mts"
  },
  "dependencies": {
    "@mnemonics/database": "workspace:*",
    "@mnemonics/shared": "workspace:*",
    "@supabase/supabase-js": "^2.57.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.5",
    "@vitest/coverage-v8": "3.2.7",
    "supertest": "^7.1.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "3.2.7"
  }
}
