{
  "manifest_version": 3,
  "name": "Mnemonics — AI Smart Bookmark",
  "version": "1.2.2",
  "description": "Lưu ký ức tức thì từ bất kỳ trang web nào.",
  "action": {
    "default_popup": "mnemonics-extension.html",
    "default_title": "Mnemonics — AI Smart Bookmark",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "contextMenus",
    "notifications",
    "unlimitedStorage"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "mnemonics-dashboard.html",
        "dashboard.js",
        "screenshot-cropper.html",
        "screenshot-cropper.js",
        "api-client.js",
        "auth-client.js",
        "original-image.html",
        "original-image.js",
        "styles/*.css",
        "limits.js",
        "*.png",
        "*.jpg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://mnemonics-api.onrender.com https://*.supabase.co https:; img-src 'self' data: blob: https: chrome-extension:;"
  }
}

