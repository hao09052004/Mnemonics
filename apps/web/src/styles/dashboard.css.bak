/* Mnemonics — Authenticated dashboard styles.
 *
 * One stylesheet that owns the dark "second brain" canvas. Components
 * reach for class names rather than inlining hex / pixel values.
 *
 * Hierarchy:
 *   .mn-app              — root layout grid (rail + canvas)
 *   .mn-rail             — left icon rail (desktop) / bottom bar (mobile)
 *   .mn-canvas           — the wide memory surface
 *   .mn-topbar           — top-right contextual nav
 *   .mn-search           — hero search
 *   .mn-filters          — pill row
 *   .mn-canvas-grid      — masonry grid for memory cards
 *   .mn-card             — base card; specialised variants per type
 *   .mn-skel             — skeleton loading blocks
 *
 * Touch / focus / motion respects `prefers-reduced-motion`.
 */

.mn-app {
  display: grid;
  grid-template-columns: var(--mn-rail) minmax(0, 1fr);
  min-height: 100vh;
  background: var(--mn-bg);
  color: var(--mn-text);
}

.mn-app__main {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.mn-canvas {
  width: 100%;
  max-width: var(--mn-canvas-max);
  margin: 0 auto;
  padding: 20px var(--mn-canvas-pad) 64px;
  min-width: 0;
}

/* -----------------  Top bar  ----------------- */

.mn-topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 14px var(--mn-canvas-pad);
  background: linear-gradient(180deg, var(--mn-bg) 70%, rgba(17, 19, 24, 0.85) 100%);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--mn-border);
}

.mn-topbar__brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-weight: 600;
  letter-spacing: -0.01em;
  color: var(--mn-text);
  font-size: 15px;
}

.mn-topbar__chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 999px;
  background: var(--mn-brand);
  color: white;
  font-weight: 700;
  font-size: 13px;
  box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08) inset;
}

.mn-topbar__nav {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 14px;
}

.mn-topbar__link {
  color: var(--mn-text-2);
  padding: 6px 12px;
  border-radius: 8px;
  transition: color var(--mn-dur) var(--mn-ease), background var(--mn-dur) var(--mn-ease);
}
.mn-topbar__link:hover {
  color: var(--mn-text);
  background: var(--mn-surface-hover);
}
.mn-topbar__link[data-active="true"] {
  color: var(--mn-text);
  background: var(--mn-surface-hover);
}

.mn-topbar__user {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--mn-text-2);
  font-size: 13px;
}
.mn-topbar__avatar {
  width: 28px;
  height: 28px;
  border-radius: 999px;
  background: var(--mn-surface-2);
  color: var(--mn-text);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  font-size: 12px;
}

/* -----------------  Left rail  ----------------- */

.mn-rail {
  position: sticky;
  top: 0;
  align-self: start;
  height: 100vh;
  border-right: 1px solid var(--mn-border);
  background: var(--mn-bg-elev);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16px 8px;
  gap: 6px;
}

.mn-rail__brand {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: var(--mn-brand);
  color: white;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 16px;
  margin-bottom: 10px;
  box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.06) inset;
}

.mn-rail__item {
  width: 44px;
  height: 44px;
  border-radius: 10px;
  border: 0;
  background: transparent;
  color: var(--mn-text-2);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background var(--mn-dur) var(--mn-ease), color var(--mn-dur) var(--mn-ease), transform var(--mn-dur-fast) var(--mn-ease);
  position: relative;
}
.mn-rail__item:hover {
  color: var(--mn-text);
  background: var(--mn-surface-hover);
}
.mn-rail__item[data-active="true"] {
  color: var(--mn-text);
  background: var(--mn-brand-soft);
}
.mn-rail__item[data-active="true"]::after {
  content: "";
  position: absolute;
  left: -8px;
  top: 12px;
  bottom: 12px;
  width: 2px;
  border-radius: 2px;
  background: var(--mn-brand);
}
.mn-rail__item:focus-visible {
  outline: 2px solid var(--mn-brand);
  outline-offset: 2px;
}

.mn-rail__divider {
  height: 1px;
  width: 24px;
  background: var(--mn-border);
  margin: 6px 0;
}

.mn-rail__spacer {
  flex: 1;
}

/* -----------------  Hero search  ----------------- */

.mn-hero {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-top: 18px;
  margin-bottom: 18px;
}

.mn-hero__hello {
  font-size: var(--mn-fs-h1);
  font-weight: 600;
  letter-spacing: -0.015em;
  color: var(--mn-text);
  margin: 0;
}

.mn-hero__sub {
  margin: 0;
  color: var(--mn-text-2);
  font-size: var(--mn-fs-small);
}

.mn-search {
  position: relative;
  margin-top: 18px;
}

.mn-search__field {
  width: 100%;
  background: transparent;
  border: 0;
  border-bottom: 1px solid var(--mn-border-strong);
  color: var(--mn-text);
  font-family: var(--mn-font-sans);
  font-size: var(--mn-fs-hero);
  font-weight: 500;
  letter-spacing: -0.02em;
  line-height: 1.15;
  padding: 14px 96px 16px 0;
  outline: none;
  transition: border-color var(--mn-dur) var(--mn-ease);
}
.mn-search__field::placeholder {
  color: var(--mn-text-3);
  font-weight: 400;
}
.mn-search__field:focus {
  border-color: var(--mn-brand);
}
.mn-search__field:focus + .mn-search__hint {
  color: var(--mn-text-2);
}

.mn-search__hint {
  position: absolute;
  right: 4px;
  bottom: 16px;
  font-size: 12px;
  color: var(--mn-text-3);
  display: inline-flex;
  align-items: center;
  gap: 6px;
  pointer-events: none;
  transition: color var(--mn-dur) var(--mn-ease);
}
.mn-search__hint kbd {
  font-family: var(--mn-font-sans);
  background: var(--mn-surface);
  border: 1px solid var(--mn-border);
  padding: 2px 6px;
  border-radius: 6px;
  font-size: 11px;
  color: var(--mn-text-2);
}

.mn-search__status {
  margin-top: 6px;
  color: var(--mn-text-3);
  font-size: 12px;
}

/* -----------------  Filter pills  ----------------- */

.mn-filters {
  display: flex;
  align-items: center;
  gap: 6px;
  margin: 22px 0 12px;
  overflow-x: auto;
  scrollbar-width: none;
  padding-bottom: 2px;
}
.mn-filters::-webkit-scrollbar {
  display: none;
}

.mn-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  height: 32px;
  padding: 0 14px;
  border-radius: 999px;
  border: 0;
  background: var(--mn-surface);
  color: var(--mn-text-2);
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  transition: background var(--mn-dur) var(--mn-ease), color var(--mn-dur) var(--mn-ease), transform var(--mn-dur-fast) var(--mn-ease);
  white-space: nowrap;
}
.mn-pill:hover {
  color: var(--mn-text);
  background: var(--mn-surface-hover);
}
.mn-pill[data-active="true"] {
  background: var(--mn-brand-soft);
  color: var(--mn-text);
}
.mn-pill[data-active="true"] .mn-pill__dot {
  background: var(--mn-brand);
}

.mn-pill__dot {
  width: 6px;
  height: 6px;
  border-radius: 999px;
  background: transparent;
}

.mn-pill__icon {
  display: inline-flex;
  width: 14px;
  height: 14px;
}

.mn-filters__spacer {
  flex: 1;
}

.mn-filters__sort {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: var(--mn-text-2);
  font-size: 12px;
  background: transparent;
  border: 0;
  cursor: pointer;
  padding: 6px 8px;
  border-radius: 8px;
}
.mn-filters__sort:hover {
  background: var(--mn-surface-hover);
  color: var(--mn-text);
}

/* -----------------  Masonry canvas  ----------------- */

.mn-canvas-grid {
  column-count: 4;
  column-gap: 20px;
  margin-top: 18px;
}

@media (max-width: 1480px) {
  .mn-canvas-grid {
    column-count: 3;
  }
}
@media (max-width: 980px) {
  .mn-canvas-grid {
    column-count: 2;
  }
}
@media (max-width: 620px) {
  .mn-canvas-grid {
    column-count: 1;
  }
}

.mn-canvas-grid > * {
  break-inside: avoid;
  display: block;
  margin-bottom: 20px;
}

/* -----------------  Card  ----------------- */

.mn-card {
  background: var(--mn-surface);
  border: 1px solid var(--mn-border);
  border-radius: var(--mn-r-md);
  padding: 0;
  display: flex;
  flex-direction: column;
  cursor: pointer;
  position: relative;
  overflow: hidden;
  transition: border-color var(--mn-dur) var(--mn-ease),
    transform var(--mn-dur-fast) var(--mn-ease),
    background var(--mn-dur) var(--mn-ease);
}
.mn-card:hover {
  border-color: var(--mn-border-strong);
  background: var(--mn-surface-2);
  transform: translateY(-1px);
}
.mn-card:focus-visible {
  outline: 2px solid var(--mn-brand);
  outline-offset: 2px;
}

.mn-card__accent {
  position: absolute;
  inset: 0 0 auto 0;
  height: 2px;
  background: transparent;
}
.mn-card[data-type="screenshot"] .mn-card__accent,
.mn-card[data-type="image"] .mn-card__accent {
  background: var(--mn-brand);
}
.mn-card[data-type="link"] .mn-card__accent,
.mn-card[data-type="article"] .mn-card__accent {
  background: var(--mn-text-3);
}

.mn-card__media {
  width: 100%;
  display: block;
  background: var(--mn-surface-2);
  border-bottom: 1px solid var(--mn-border);
  object-fit: cover;
}

.mn-card__body {
  padding: 14px 14px 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.mn-card__kind {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--mn-text-3);
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.mn-card__title {
  margin: 0;
  font-size: var(--mn-fs-card-title);
  font-weight: 600;
  line-height: 1.35;
  letter-spacing: -0.005em;
  color: var(--mn-text);
  word-break: break-word;
}

.mn-card__tldr {
  margin: 0;
  color: var(--mn-text-2);
  font-size: 13px;
  line-height: 1.55;
}

.mn-card__snippet {
  margin: 0;
  color: var(--mn-text-2);
  font-size: 13px;
  line-height: 1.55;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.mn-card__quote {
  margin: 0;
  color: var(--mn-text);
  font-size: 16px;
  line-height: 1.45;
  font-weight: 500;
  letter-spacing: -0.005em;
  position: relative;
  padding-left: 12px;
  border-left: 2px solid var(--mn-brand-soft);
}

.mn-card__meta {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 4px;
  font-size: 12px;
  color: var(--mn-text-3);
}

.mn-card__meta-domain {
  color: var(--mn-text-2);
  font-weight: 500;
}

.mn-card__meta-dot {
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: var(--mn-text-3);
  display: inline-block;
}

.mn-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  margin-top: 4px;
}

.mn-card__tag {
  font-size: 11px;
  padding: 2px 8px;
  border-radius: 999px;
  background: var(--mn-bg-elev);
  color: var(--mn-text-2);
  border: 1px solid var(--mn-border);
  cursor: pointer;
}
.mn-card__tag:hover {
  color: var(--mn-text);
  border-color: var(--mn-border-strong);
}

/* Mnemonics-specific: connection glint */
.mn-card__glint {
  position: absolute;
  top: 10px;
  right: 10px;
  width: 8px;
  height: 8px;
  border-radius: 999px;
  background: var(--mn-brand);
  box-shadow: 0 0 0 4px rgba(116, 87, 232, 0.18);
  opacity: 0;
  transform: scale(0.6);
  transition: opacity var(--mn-dur) var(--mn-ease), transform var(--mn-dur) var(--mn-ease);
}
.mn-card[data-related="true"] .mn-card__glint {
  opacity: 1;
  transform: scale(1);
}

/* Card hover-only actions */
.mn-card__actions {
  position: absolute;
  inset: auto 8px 8px auto;
  display: flex;
  gap: 4px;
  opacity: 0;
  transition: opacity var(--mn-dur) var(--mn-ease);
}
.mn-card:hover .mn-card__actions,
.mn-card:focus-within .mn-card__actions {
  opacity: 1;
}

.mn-card__action {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  background: rgba(17, 19, 24, 0.7);
  backdrop-filter: blur(6px);
  color: var(--mn-text-2);
  border: 1px solid var(--mn-border);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: color var(--mn-dur) var(--mn-ease), border-color var(--mn-dur) var(--mn-ease);
}
.mn-card__action:hover {
  color: var(--mn-text);
  border-color: var(--mn-border-strong);
}
.mn-card__action[data-active="true"] {
  color: var(--mn-brand);
}

/* Status row (favourite + processing) */
.mn-card__status {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: var(--mn-text-3);
  font-size: 12px;
}
.mn-card__status-dot {
  width: 6px;
  height: 6px;
  border-radius: 999px;
  background: var(--mn-text-3);
}
.mn-card__status[data-state="processing"] .mn-card__status-dot {
  background: var(--mn-warn);
  animation: mn-pulse 1.6s ease-in-out infinite;
}
.mn-card__status[data-state="failed"] .mn-card__status-dot {
  background: var(--mn-danger);
}
@keyframes mn-pulse {
  0%, 100% { opacity: 0.4; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1); }
}

/* -----------------  Skeleton  ----------------- */

.mn-skel {
  background: var(--mn-surface);
  border: 1px solid var(--mn-border);
  border-radius: var(--mn-r-md);
  overflow: hidden;
  break-inside: avoid;
  margin-bottom: 20px;
}
.mn-skel__bar {
  background: linear-gradient(90deg,
    var(--mn-surface) 0%,
    var(--mn-surface-hover) 50%,
    var(--mn-surface) 100%);
  background-size: 200% 100%;
  animation: mn-shimmer 1.6s linear infinite;
}
.mn-skel__img {
  height: 180px;
}
.mn-skel__line {
  height: 12px;
  margin: 8px 14px;
  border-radius: 4px;
}
.mn-skel__line:nth-child(1) { width: 60%; margin-top: 14px; }
.mn-skel__line:nth-child(2) { width: 90%; }
.mn-skel__line:nth-child(3) { width: 70%; }
.mn-skel__line:nth-child(4) { width: 40%; margin-bottom: 14px; }
.mn-skel--short .mn-skel__img { height: 100px; }
.mn-skel--tall .mn-skel__img { height: 280px; }
@keyframes mn-shimmer {
  0% { background-position: 0 0; }
  100% { background-position: -200% 0; }
}

/* -----------------  Empty / error  ----------------- */

.mn-empty {
  text-align: center;
  padding: 96px 24px;
  color: var(--mn-text-2);
  border: 1px dashed var(--mn-border-strong);
  border-radius: var(--mn-r-lg);
  background: linear-gradient(180deg, var(--mn-bg-elev), transparent);
}
.mn-empty h3 {
  margin: 0 0 8px;
  font-size: 20px;
  font-weight: 600;
  letter-spacing: -0.01em;
  color: var(--mn-text);
}
.mn-empty p {
  margin: 0 auto;
  max-width: 460px;
  font-size: 14px;
  line-height: 1.55;
}
.mn-empty__cta {
  margin-top: 18px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--mn-brand);
  color: white;
  padding: 10px 18px;
  border-radius: 999px;
  font-weight: 600;
  font-size: 14px;
  border: 0;
  cursor: pointer;
}
.mn-empty__cta:hover {
  background: var(--mn-brand-hover);
}

.mn-error {
  margin: 16px 0;
  padding: 12px 14px;
  border-radius: var(--mn-r-sm);
  background: var(--mn-danger-soft);
  color: var(--mn-danger);
  font-size: 13px;
}

/* -----------------  Quick capture card (first slot)  ----------------- */

.mn-capture {
  background: var(--mn-bg-elev);
  border: 1px dashed var(--mn-border-strong);
  border-radius: var(--mn-r-md);
  padding: 18px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  cursor: pointer;
  transition: border-color var(--mn-dur) var(--mn-ease), background var(--mn-dur) var(--mn-ease);
}
.mn-capture:hover {
  border-color: var(--mn-brand);
  background: var(--mn-brand-tint);
}
.mn-capture__label {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--mn-brand);
}
.mn-capture__hint {
  font-size: 14px;
  color: var(--mn-text);
  font-weight: 500;
}

/* -----------------  Demo banner  ----------------- */

.mn-demo {
  margin: 12px 0 24px;
  padding: 12px 16px;
  border-radius: var(--mn-r-sm);
  background: var(--mn-brand-tint);
  border: 1px solid var(--mn-brand-soft);
  color: var(--mn-text-2);
  font-size: 13px;
  line-height: 1.55;
}
.mn-demo b {
  color: var(--mn-text);
}

/* -----------------  Mobile bottom nav  ----------------- */

.mn-bottomnav {
  display: none;
}

@media (max-width: 760px) {
  .mn-app {
    grid-template-columns: minmax(0, 1fr);
    padding-bottom: 60px;
  }
  .mn-rail {
    position: fixed;
    inset: auto 0 0 0;
    height: 60px;
    flex-direction: row;
    justify-content: space-around;
    padding: 8px 12px;
    z-index: 30;
    border-top: 1px solid var(--mn-border);
    border-right: 0;
    width: 100%;
  }
  .mn-rail__brand,
  .mn-rail__divider,
  .mn-rail__spacer {
    display: none;
  }
  .mn-rail__item {
    width: 44px;
    height: 44px;
  }
  .mn-rail__item[data-active="true"]::after {
    left: 12px;
    right: 12px;
    top: auto;
    bottom: 2px;
    width: auto;
    height: 2px;
  }
  .mn-canvas {
    padding: 16px 14px 96px;
  }
  .mn-search__field {
    font-size: 28px;
  }
  .mn-hero__hello {
    font-size: 22px;
  }
  .mn-canvas-grid {
    column-count: 1;
  }
}