# Mnemonics web — public env contract.
#
# Copy this file to `.env` and fill in production values before
# `pnpm build`. Vite inlines these at build time.
#
# All values are PUBLIC — do NOT put secrets here. Auth tokens, DB
# passwords, etc. live in the API service, not the marketing site.

# REST base URL. The dashboard and the marketing demo both hit this.
#   - Dev:        http://localhost:4000  (vite dev server)
#   - Production: https://api.<your-domain>
VITE_API_URL=

# Chrome Web Store listing for the "Add to Chrome" CTA. When empty,
# the button shows a "release coming soon" modal instead of opening
# the Web Store.
#   Example: https://chromewebstore.google.com/detail/<extension-id>
VITE_CHROME_EXTENSION_URL=

# Microsoft Edge Add-ons listing for the "Add to Edge" CTA. Same
# empty semantics as the Chrome URL. When unset, the Edge CTA falls
# back to the Chrome Web Store URL.
#   Example: https://microsoftedge.microsoft.com/addons/detail/<extension-id>
VITE_EDGE_EXTENSION_URL=

# Public web URL. The extension popup uses this to render the
# "Open Mnemonics" link back to the dashboard. Falls back to the
# current origin at runtime if unset.
#   - Dev:        http://localhost:3000
#   - Production: https://<your-domain>
VITE_WEB_URL=

# Demo mode. When true, the dashboard exposes a one-click
# demo login (no real credentials required). Leave unset in
# production builds.
VITE_DEMO_MODE=
