NODE_ENV=development
DEMO_MODE=false
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000
DEV_AUTH_TOKEN=mnemonics-dev-token
DEV_USER_ID=00000000-0000-4000-8000-000000000001
# Dev-only: when true, /api/v1/auth/register bypasses email verification by
# creating the user via the service-role admin client. Required when the
# Supabase IP-level email rate limit is blocking QA sign-ups. Leave OFF in prod.
AUTH_AUTO_CONFIRM=false
DATABASE_URL=postgresql://user:password@localhost:5432/mnemonics
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me
JWT_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me

# Object storage
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Extension
EXTENSION_ID=

# ============================================================
# AI providers — Mnemonics defaults to ZERO-PAID-AI-COST mode.
# ============================================================

# Every AI feature runs on Gemini first and falls back to a LOCAL
# Ollama daemon. OpenAI/ChatGPT is no longer supported at all: there
# is no OPENAI_API_KEY and no openai provider in the codebase.
# AI_FREE_ONLY=true is kept as a guard so a future paid provider
# cannot be enabled silently.
AI_FREE_ONLY=true

# Text generation (tags, summaries, suggested Space titles)
# Primary: AI_TEXT_PROVIDER=gemini | ollama | heuristic
# Fallback: when AI_TEXT_FALLBACK=true and primary is gemini/ollama,
#   the FallingBackTextProvider wraps the primary and re-runs the
#   call on a local Ollama daemon (or, for ollama primary, on the
#   deterministic heuristic) if the primary throws ProviderError.
AI_TEXT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TEXT_FALLBACK=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=llama3.2:3b

# Text embeddings (pgvector column is vector(1024) — migration 017)
# Primary:  AI_EMBEDDING_PROVIDER=gemini | ollama | noop
# Fallback: gemini -> local Ollama -> noop (lexical-only search).
# Both Gemini and the local model emit EXACTLY 1024 floats, because
# they share one column: mixing embedding widths in a single pgvector
# column silently corrupts similarity ranking.
#
# The local fallback model MUST be 1024-d. `bge-m3` is the default:
#     ollama pull bge-m3
# A model of a different width (nomic-embed-text=768, bge-small=384)
# is rejected at runtime rather than padded — a padded vector ranks on
# its zero tail and returns nonsense.
AI_EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Must match item_embeddings.embedding (vector(1024)).
GEMINI_EMBEDDING_DIMENSIONS=1024
# Local embedding model — must also be 1024-d (bge-m3).
OLLAMA_EMBEDDING_MODEL=bge-m3
AI_EMBEDDING_FALLBACK=true

# Ollama runtime
# Force CPU even when a GPU is present. Set to true when CUDA/cuDNN
# is broken on the host — Ollama attempts GPU execution first and fails
# with a stack-buffer-overrun before falling back automatically.
OLLAMA_FORCE_CPU=false

# OCR (OCR.Space free tier + Tesseract local fallback)
OCR_PROVIDER=ocrspace
OCR_SPACE_API_KEY=
OCR_SPACE_DAILY_SOFT_LIMIT=450
OCR_LOCAL_FALLBACK=true

# Visual similarity (CLIP, runs locally, no API key)
VISUAL_EMBEDDING_PROVIDER=local
VISUAL_EMBEDDING_MODEL=Xenova/clip-vit-base-patch32

# Memory Understanding: image description (local caption model)
# Choose one of:
#   Xenova/vit-gpt2-image-captioning      ~250MB, MIT, fastest
#   Xenova/Salesforce/blip-image-captioning-base  ~440MB, MIT, higher quality
# When AI_IMAGE_DESCRIPTION_ALLOW_DOWNLOAD=false the provider
# returns a deterministic placeholder (used in tests + CI).
LOCAL_IMAGE_DESCRIPTION_MODEL=Xenova/vit-gpt2-image-captioning
AI_IMAGE_DESCRIPTION_ALLOW_DOWNLOAD=true

# Memory Understanding: TLDR
#   deterministic   always works, no model required
#   ollama          optional local LLM upgrade (needs OLLAMA_BASE_URL)
AI_TLDR_PROVIDER=deterministic
TLDR_MAX_LENGTH=240
AI_TLDR_MIN_TEXT_LENGTH=160

# OpenAI / ChatGPT: intentionally absent. The project uses Gemini with
# a local Ollama fallback; an OPENAI_API_KEY in your .env is ignored.
