NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000
DEV_AUTH_TOKEN=mnemonics-dev-token
DEV_USER_ID=00000000-0000-4000-8000-000000000001
# Dev-only: when true, /api/v1/auth/register bypasses email verification by
# creating the user via the service-role admin client. Required when the
# Supabase IP-level email rate limit is blocking QA sign-ups. Leave OFF in prod.
AUTH_AUTO_CONFIRM=false
DATABASE_URL=postgresql://user:password@localhost:5432/mnemonics
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me
JWT_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me

# Object storage
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# AI providers
OCR_PROVIDER=
OCR_API_KEY=
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
EMBEDDING_API_KEY=

# Extension
EXTENSION_ID=