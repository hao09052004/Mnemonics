NODE_ENV=development
DEMO_MODE=false
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000
DEV_AUTH_TOKEN=mnemonics-dev-token
DEV_USER_ID=00000000-0000-4000-8000-000000000001
# Dev-only: when true, /api/v1/auth/register bypasses email verification by
# creating the user via the service-role admin client. Required when the
# Supabase IP-level email rate limit is blocking QA sign-ups. Leave OFF in prod.
AUTH_AUTO_CONFIRM=false
DATABASE_URL=postgresql://user:password@localhost:5432/mnemonics
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me
JWT_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me

# Object storage
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Extension
EXTENSION_ID=

# ============================================================
# AI providers — Mnemonics defaults to ZERO-PAID-AI-COST mode.
# ============================================================

# When AI_FREE_ONLY=true, OpenAI is forbidden and the visual
# provider must be local. Do not change unless you have a paid
# budget approved.
AI_FREE_ONLY=true

# Text generation (tags, summaries, suggested Space titles)
# Primary: AI_TEXT_PROVIDER=gemini | ollama | heuristic
# Fallback: when AI_TEXT_FALLBACK=true and primary is gemini/ollama,
#   the FallingBackTextProvider wraps the primary and re-runs the
#   call on a local Ollama daemon (or, for ollama primary, on the
#   deterministic heuristic) if the primary throws ProviderError.
AI_TEXT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TEXT_FALLBACK=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=llama3.2:3b

# Text embeddings (pgvector 1536-d column is the schema default)
# Same fallback contract: if the primary throws, FallingBackEmbeddingProvider
# routes to NoopEmbeddingProvider (which refuses to embed; the search
# route degrades to lexical-only). There is no 1536-d Ollama model
# shipped by default, so the embedding fallback is intentionally
# "no semantic search" rather than "fake-semantic search".
AI_EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=1536
AI_EMBEDDING_FALLBACK=true

# OCR (OCR.Space free tier + Tesseract local fallback)
OCR_PROVIDER=ocrspace
OCR_SPACE_API_KEY=
OCR_SPACE_DAILY_SOFT_LIMIT=450
OCR_LOCAL_FALLBACK=true

# Visual similarity (CLIP, runs locally, no API key)
VISUAL_EMBEDDING_PROVIDER=local
VISUAL_EMBEDDING_MODEL=Xenova/clip-vit-base-patch32

# OPENAI_API_KEY is OPTIONAL legacy support only. It must NOT be
# required by capture, search, tags, embeddings, OCR, or visual
# similarity when AI_FREE_ONLY=true. See docs/free-ai-setup.md.
OPENAI_API_KEY=
