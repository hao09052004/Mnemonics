# Mnemonics — Gemini-only server-side production configuration.
#
# This file is the SHIPPED target. The code in `packages/ai` honours
# every variable below. The previous "DO NOT USE AS-IS" warning has
# been removed because the migration task has been implemented.
#
# IMPORTANT: never commit your populated .env, and never paste real
# secrets in chat. Set real values in your hosting platform's
# environment-variable dashboard, or in an untracked local .env.

NODE_ENV=production
DEMO_MODE=false
AUTH_AUTO_CONFIRM=false

PORT=4000
WEB_URL=https://YOUR-WEB-HOST.example
API_URL=https://YOUR-API-HOST.example

# Backend-only secrets. Set privately in hosting dashboard or untracked .env.
# The frontend (apps/web) and the browser extension MUST NOT receive any of
# these values. Do not use the VITE_* prefix on any of them.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

# Cloud-based AI. No Ollama / Tesseract / Transformers.js / CLIP inference
# in production. The Gemini Developer API Free Tier must be VERIFIED for
# the configured models and the configured project before going live.
# See docs/deployment.md#gemini-billing.
AI_FREE_ONLY=true
AI_TEXT_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
AI_TEXT_FALLBACK=false

AI_EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=1024
AI_EMBEDDING_FALLBACK=false

# OCR: server-side Gemini multimodal text extraction.
# The fallback chain is gemini → ocrspace → tesseract. In production
# the local Tesseract fallback is disabled to avoid pulling a 30 MB
# WASM binary on first use.
OCR_PROVIDER=gemini
OCR_LOCAL_FALLBACK=false
# OCR.Space is the explicit operator-selected cloud fallback. Set
# OCR_PROVIDER=ocrspace to enable it; OCR_LOCAL_FALLBACK is
# ignored when OCR_PROVIDER is ocrspace.
OCR_SPACE_API_KEY=

# Image description: server-side Gemini multimodal caption.
# The local Transformers.js fallback is disabled to avoid pulling
# a vision model on first use.
AI_IMAGE_DESCRIPTION_PROVIDER=gemini
AI_IMAGE_DESCRIPTION_ALLOW_DOWNLOAD=false

# TLDR: server-side Gemini summary.
AI_TLDR_PROVIDER=gemini

# Optional cloud visual embeddings. STORED SEPARATELY from text
# embeddings (different model id, different dimension count) so the
# two similarity spaces are never compared. The model listed below
# is NOT on the verified-Free-Tier list as of the file date; the
# config validator refuses to mount VISUAL_EMBEDDING_PROVIDER=gemini
# when AI_FREE_ONLY=true and the model is unknown. Verify Free-Tier
# availability on the Google AI Studio model catalog before enabling.
VISUAL_EMBEDDING_PROVIDER=gemini
GEMINI_VISUAL_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_VISUAL_EMBEDDING_DIMENSIONS=512

# Gemini resilience and load shedding.
GEMINI_REQUEST_TIMEOUT_MS=45000
# Hard cap on how long the RPM pacer may sleep before a request is
# started. 0 disables the cap. New in this milestone.
GEMINI_QUEUE_WAIT_TIMEOUT_MS=30000
# Overall request-execution budget. EXCLUDES the pacer wait, so a
# long queue wait cannot cause a request to time out before it
# actually fires. New in this milestone.
GEMINI_TOTAL_BUDGET_MS=60000
# Caller-side deadline for the full TLDR operation (long PDFs).
# New in this milestone.
GEMINI_TLDR_TOTAL_BUDGET_MS=90000
GEMINI_MAX_RETRIES=2
GEMINI_MAX_CONCURRENT_REQUESTS=2
GEMINI_RATE_LIMIT_RPM=2

# CORS allowlist. Comma-separated list of origins the API will
# respond to. The browser extension is always allowed (any
# chrome-extension:// and edge-extension:// origin); requests with
# no Origin header (CLI, server-to-server, extension background)
# are always allowed. In production, arbitrary origins are
# refused. Example:
#   CORS_ALLOWED_ORIGNS=https://app.mnemonics.example,https://mnemonics.example
# Leave empty in development to use the default
# localhost allow-list.
CORS_ALLOWED_ORIGNS=

# Per-user daily AI call cap. Enforced by UserAiQuota in packages/ai.
# Prevents a single user from burning the shared Free-Tier quota.
# The cap is in PROVIDER CALLS, not in prompt tokens. Default 100.
AI_USER_DAILY_LIMIT=100

# Clusters remain deterministic; no LLM-based naming.
CONTENT_CLUSTERING_ENABLED=true
CONTENT_CLUSTER_MIN_SIZE=3
CONTENT_CLUSTER_SIMILARITY_THRESHOLD=0.78

# Backend-only secrets, set in the hosting dashboard.
# The frontend (apps/web) and the browser extension MUST NOT receive
# any of the values above. Do not use the VITE_* prefix on any of
# the variables in this file.
