# Mnemonics — production-only environment template.
#
# Use this as a checklist when configuring a production host. The
# runtime NEVER reads this file; it is a documentation artefact
# (`.example` extension, gitignored at the file level). Copy the
# values into the host's private environment variable store.
#
# Every secret below MUST be set via the host's private variable
# management. NEVER bake them into the build artefact. NEVER use
# the VITE_ prefix on any backend-only secret.
#
# Required production checklist (operator):
#
#   [ ] NODE_ENV=production
#   [ ] DEMO_MODE=false
#   [ ] AUTH_AUTO_CONFIRM=false
#   [ ] DATABASE_URL points to a Supabase project with migrations
#       001-023 applied. The order in which you apply them matters:
#       follow packages/database/scripts/migrate.ts --dry-run before
#       --apply.
#   [ ] SUPABASE_SERVICE_ROLE_KEY rotated; never embedded in the
#       browser or extension bundle.
#   [ ] GEMINI_API_KEY is a Gemini Developer API key (NOT Vertex AI)
#       with Free-Tier eligibility VERIFIED for the configured
#       models. See docs/deployment.md#gemini-billing.
#   [ ] AI_FREE_ONLY=true (forces refusal of any non-Free-Tier
#       provider). Remove only after a billing-tier review.
#   [ ] AI_USER_DAILY_LIMIT set to a value that survives a single
#       user uploading a 200-page PDF.
#   [ ] Privacy disclosure rendered in the web dashboard and the
#       extension's onboarding flow. See docs/privacy.md.

# ─── Runtime ────────────────────────────────────────────────────
NODE_ENV=production
DEMO_MODE=false
AUTH_AUTO_CONFIRM=false
PORT=4000
WEB_URL=https://YOUR-WEB-HOST.example
API_URL=https://YOUR-API-HOST.example

# ─── Backend-only secrets (private) ─────────────────────────────
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

# ─── AI: cloud-only mode ────────────────────────────────────────
# No Ollama, no Tesseract, no Transformers.js, no local CLIP. The
# gateway client (`packages/ai/src/gemini-client.ts`) enforces
# timeout, retry, rate-limit, concurrency, and circuit breaker for
# every Gemini call.
AI_FREE_ONLY=true
AI_TEXT_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
AI_TEXT_FALLBACK=false

AI_EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=1024
AI_EMBEDDING_FALLBACK=false

OCR_PROVIDER=gemini
OCR_LOCAL_FALLBACK=false

AI_IMAGE_DESCRIPTION_PROVIDER=gemini
AI_IMAGE_DESCRIPTION_ALLOW_DOWNLOAD=false

AI_TLDR_PROVIDER=gemini

# Cloud visual embeddings are KEPT DISTINCT from text embeddings.
# Verify Free-Tier availability on the Google AI Studio model
# catalog before enabling. The config validator refuses to mount
# the provider when AI_FREE_ONLY=true and the model is not on the
# verified list (see packages/ai/src/ai-config.ts).
VISUAL_EMBEDDING_PROVIDER=gemini
GEMINI_VISUAL_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_VISUAL_EMBEDDING_DIMENSIONS=512

# ─── Resilience and load shedding ───────────────────────────────
GEMINI_REQUEST_TIMEOUT_MS=45000
GEMINI_MAX_RETRIES=2
GEMINI_MAX_CONCURRENT_REQUESTS=2
GEMINI_RATE_LIMIT_RPM=2

# Per-user daily AI cap (calls, not tokens). Prevents a single
# user from exhausting the shared Free-Tier quota. Default 100.
AI_USER_DAILY_LIMIT=100

# ─── Content Clusters (deterministic) ───────────────────────────
CONTENT_CLUSTERING_ENABLED=true
CONTENT_CLUSTER_MIN_SIZE=3
CONTENT_CLUSTER_SIMILARITY_THRESHOLD=0.78
